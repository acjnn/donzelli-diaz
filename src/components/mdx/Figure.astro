---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	src: ImageMetadata | string;
	alt: string;
	caption?: string;
	credit?: string;
	wide?: boolean;
}

const { src, alt, caption, credit, wide = false } = Astro.props;
const isRemote = typeof src === "string";
---

<figure class:list={[{ "figure--wide": wide }]}>
	{
		isRemote ? (
			<img src={src as string} alt={alt} loading="lazy" decoding="async" />
		) : (
			<Image src={src as ImageMetadata} alt={alt} widths={[480, 768, 1200, 1600]} sizes="(max-width: 68ch) 100vw, 68ch" />
		)
	}
	{
		(caption || credit) && (
			<figcaption>
				{caption}
				{credit && <span class="figure-credit"> — {credit}</span>}
			</figcaption>
		)
	}
</figure>
