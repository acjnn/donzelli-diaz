---
import {
	CHART_H,
	CHART_W,
	MARGIN,
	formatTick,
	jitter,
	linearScale,
	niceTicks,
	toNumbers,
	type ChartProps,
} from "./chart-utils";

interface Props extends ChartProps {}

const {
	data,
	x,
	y,
	title,
	caption,
	width = CHART_W,
	height = CHART_H,
	annotations = [],
} = Astro.props;

const plotW = width - MARGIN.left - MARGIN.right;
const plotH = height - MARGIN.top - MARGIN.bottom;

const ys = toNumbers(data, y);
const yMin = Math.min(...ys, 0);
const yMax = Math.max(...ys);
const yPad = (yMax - yMin || 1) * 0.08;
const yScale = linearScale(yMin - yPad, yMax + yPad, MARGIN.top + plotH, MARGIN.top);
const xScale = linearScale(0, Math.max(data.length - 1, 1), MARGIN.left, MARGIN.left + plotW);
const yTicks = niceTicks(yMin, yMax, 5);

const xLabel = (d: Record<string, unknown>, i: number) => {
	const v = d[x];
	return v instanceof Date ? v.toLocaleDateString("en-gb") : String(v ?? i);
};

const points = data.map((d, i) => ({
	cx: xScale.map(i),
	cy: yScale.map(Number(d[y])),
	label: xLabel(d, i),
}));

const path = points
	.map((p, i) => `${i === 0 ? "M" : "L"} ${(p.cx + jitter(i, 0.6)).toFixed(1)} ${(p.cy + jitter(i + 1000, 0.6)).toFixed(1)}`)
	.join(" ");

const maxLabels = 8;
const labelEvery = Math.max(1, Math.ceil(points.length / maxLabels));
---

<figure class="chart chart--line">
	<svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={title ?? caption ?? "Line chart"}>
		{yTicks.map((t) => (
			<g>
				<line
					class="chart-grid"
					x1={MARGIN.left}
					x2={MARGIN.left + plotW}
					y1={yScale.map(t)}
					y2={yScale.map(t)}
				/>
				<text class="chart-tick" x={MARGIN.left - 8} y={yScale.map(t) + 3} text-anchor="end">
					{formatTick(t)}
				</text>
			</g>
		))}
		{points.map((p, i) =>
			i % labelEvery === 0 ? (
				<text class="chart-tick" x={p.cx} y={height - 10} text-anchor="middle">
					{p.label}
				</text>
			) : null,
		)}
		<line class="chart-grid" style="stroke-dasharray:none" x1={MARGIN.left} x2={MARGIN.left} y1={MARGIN.top} y2={MARGIN.top + plotH} />
		<line class="chart-grid" style="stroke-dasharray:none" x1={MARGIN.left} x2={MARGIN.left + plotW} y1={MARGIN.top + plotH} y2={MARGIN.top + plotH} />
		<path class="chart-line" d={path} />
		{points.length <= 60 && points.map((p) => <circle class="chart-dot" cx={p.cx} cy={p.cy} r="3" />)}
		{annotations.map((a, i) => {
			const idx = typeof a.x === "number" ? a.x : data.findIndex((d) => String(d[x]) === String(a.x));
			if (idx < 0 || idx >= points.length) return null;
			const p = points[idx];
			return (
				<g>
					<line x1={p.cx} x2={p.cx} y1={MARGIN.top} y2={MARGIN.top + plotH} stroke="var(--accent)" stroke-width="0.8" stroke-dasharray="3 4" />
					<text class="chart-annotation" x={Math.min(p.cx + 6, width - 120)} y={MARGIN.top + 14 + i * 18}>
						{a.label}
					</text>
				</g>
			);
		})}
		{title && (
			<text class="chart-axis" x={MARGIN.left} y={14}>
				{title}
			</text>
		)}
	</svg>
	{caption && <figcaption class="chart-caption">{caption}</figcaption>}
</figure>
