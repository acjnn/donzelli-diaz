---
import {
	CHART_H,
	CHART_W,
	MARGIN,
	formatTick,
	jitter,
	linearScale,
	niceTicks,
	toNumbers,
	type ChartProps,
} from "./chart-utils";

interface Props extends ChartProps {}

const {
	data,
	x,
	y,
	title,
	caption,
	width = CHART_W,
	height = CHART_H,
	annotations = [],
} = Astro.props;

const plotW = width - MARGIN.left - MARGIN.right;
const plotH = height - MARGIN.top - MARGIN.bottom;

const ys = toNumbers(data, y);
const yMin = Math.min(...ys, 0);
const yMax = Math.max(...ys, 0);
const yPad = (yMax - yMin || 1) * 0.08;
const yScale = linearScale(yMin - (yMin < 0 ? yPad : 0), yMax + yPad, MARGIN.top + plotH, MARGIN.top);
const yTicks = niceTicks(yMin, yMax, 5);

const band = plotW / Math.max(data.length, 1);
const barW = Math.min(band * 0.62, 64);
const zeroY = yScale.map(0);

const maxLabels = 10;
const labelEvery = Math.max(1, Math.ceil(data.length / maxLabels));
---

<figure class="chart chart--bar">
	<svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={title ?? caption ?? "Bar chart"}>
		{yTicks.map((t) => (
			<g>
				<line
					class="chart-grid"
					x1={MARGIN.left}
					x2={MARGIN.left + plotW}
					y1={yScale.map(t)}
					y2={yScale.map(t)}
				/>
				<text class="chart-tick" x={MARGIN.left - 8} y={yScale.map(t) + 3} text-anchor="end">
					{formatTick(t)}
				</text>
			</g>
		))}
		<line class="chart-grid" style="stroke-dasharray:none" x1={MARGIN.left} x2={MARGIN.left} y1={MARGIN.top} y2={MARGIN.top + plotH} />
		<line class="chart-grid" style="stroke-dasharray:none" x1={MARGIN.left} x2={MARGIN.left + plotW} y1={zeroY} y2={zeroY} />
		{data.map((d, i) => {
			const v = Number(d[y]);
			if (!Number.isFinite(v)) return null;
			const cx = MARGIN.left + band * i + band / 2;
			const vy = yScale.map(v);
			const top = Math.min(vy, zeroY);
			const h = Math.abs(zeroY - vy);
			return (
				<g>
					<rect
						class="chart-bar"
						x={cx - barW / 2 + jitter(i, 0.8)}
						y={top}
						width={barW}
						height={Math.max(h, 0.5)}
						rx="1.5"
						opacity="0.9"
					/>
					{i % labelEvery === 0 && (
						<text class="chart-tick" x={cx} y={height - 10} text-anchor="middle">
							{String(d[x] ?? i)}
						</text>
					)}
				</g>
			);
		})}
		{annotations.map((a, i) => {
			const idx = typeof a.x === "number" ? a.x : data.findIndex((d) => String(d[x]) === String(a.x));
			if (idx < 0 || idx >= data.length) return null;
			const cx = MARGIN.left + band * idx + band / 2;
			return (
				<text class="chart-annotation" x={Math.min(cx + 6, width - 120)} y={MARGIN.top + 14 + i * 18}>
					{a.label}
				</text>
			);
		})}
		{title && (
			<text class="chart-axis" x={MARGIN.left} y={14}>
				{title}
			</text>
		)}
	</svg>
	{caption && <figcaption class="chart-caption">{caption}</figcaption>}
</figure>
