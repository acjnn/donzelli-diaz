---
import {
	CHART_H,
	CHART_W,
	MARGIN,
	formatTick,
	linearScale,
	niceTicks,
	toNumbers,
	type ChartProps,
} from "./chart-utils";

interface Props extends ChartProps {}

const {
	data,
	x,
	y,
	title,
	caption,
	width = CHART_W,
	height = CHART_H,
	annotations = [],
} = Astro.props;

const plotW = width - MARGIN.left - MARGIN.right;
const plotH = height - MARGIN.top - MARGIN.bottom;

const xs = toNumbers(data, x);
const ys = toNumbers(data, y);
const xMin = Math.min(...xs);
const xMax = Math.max(...xs);
const yMin = Math.min(...ys, 0);
const yMax = Math.max(...ys);
const xPad = (xMax - xMin || 1) * 0.06;
const yPad = (yMax - yMin || 1) * 0.08;
const xScale = linearScale(xMin - xPad, xMax + xPad, MARGIN.left, MARGIN.left + plotW);
const yScale = linearScale(yMin - yPad, yMax + yPad, MARGIN.top + plotH, MARGIN.top);
const xTicks = niceTicks(xMin, xMax, 6);
const yTicks = niceTicks(yMin, yMax, 5);
---

<figure class="chart chart--scatter">
	<svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={title ?? caption ?? "Scatter chart"}>
		{yTicks.map((t) => (
			<g>
				<line class="chart-grid" x1={MARGIN.left} x2={MARGIN.left + plotW} y1={yScale.map(t)} y2={yScale.map(t)} />
				<text class="chart-tick" x={MARGIN.left - 8} y={yScale.map(t) + 3} text-anchor="end">
					{formatTick(t)}
				</text>
			</g>
		))}
		{xTicks.map((t) => (
			<text class="chart-tick" x={xScale.map(t)} y={height - 10} text-anchor="middle">
				{formatTick(t)}
			</text>
		))}
		<line class="chart-grid" style="stroke-dasharray:none" x1={MARGIN.left} x2={MARGIN.left} y1={MARGIN.top} y2={MARGIN.top + plotH} />
		<line class="chart-grid" style="stroke-dasharray:none" x1={MARGIN.left} x2={MARGIN.left + plotW} y1={MARGIN.top + plotH} y2={MARGIN.top + plotH} />
		{data.map((d) => {
			const vx = Number(d[x]);
			const vy = Number(d[y]);
			if (!Number.isFinite(vx) || !Number.isFinite(vy)) return null;
			return <circle class="chart-dot" cx={xScale.map(vx)} cy={yScale.map(vy)} r="3.4" />;
		})}
		{annotations.map((a, i) => {
			if (a.x === undefined || a.y === undefined) return null;
			const vx = Number(a.x);
			if (!Number.isFinite(vx)) return null;
			return (
				<text
					class="chart-annotation"
					x={Math.min(xScale.map(vx) + 8, width - 120)}
					y={yScale.map(a.y) - 8 - i * 2}
				>
					{a.label}
				</text>
			);
		})}
		{title && (
			<text class="chart-axis" x={MARGIN.left} y={14}>
				{title}
			</text>
		)}
	</svg>
	{caption && <figcaption class="chart-caption">{caption}</figcaption>}
</figure>
