---
import { INK } from "../lib/palette";

interface Props {
	rotate?: number;
	color?: string;
	class?: string;
}

const { rotate = -3, color = INK, class: className } = Astro.props;
---

<span
	class:list={["marginalia", className]}
	style={`transform: rotate(${rotate}deg); color: ${color}`}
>
	<slot />
</span>
