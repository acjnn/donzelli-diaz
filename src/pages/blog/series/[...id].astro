---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import SectionHead from "../../../components/SectionHead.astro";
import FormattedDate from "../../../components/FormattedDate.astro";
import { getPosts, readingTime, seriesPosts } from "../../../lib/posts";

export async function getStaticPaths() {
	const allSeries = await getCollection("series");
	const posts = await getPosts();
	return allSeries
		.map((s) => ({
			params: { id: s.id },
			props: { series: s, parts: seriesPosts(posts, s.id) },
		}))
		.filter((entry) => entry.props.parts.length > 0);
}

const { series, parts } = Astro.props;
---

<Base
	title={series.data.title}
	description={series.data.description}
	section="BLOG / SERIES"
>
	<section class="section" style="padding-top: clamp(1.5rem, 3vw, 2.6rem)">
		<SectionHead num="§" title={series.data.title} sub="a series" />
		<p class="series-desc">{series.data.description}</p>

		{
			parts.length === 0 ? (
				<p class="series-empty">
					<em>No posts in this series yet.</em>
				</p>
			) : (
				<ul class="dispatch-list">
					{parts.map((post) => {
						const rt = readingTime(post);
						return (
							<li class="dispatch">
								<a href={`/blog/${post.id}/`}>
									<span class="dispatch__date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<div class="dispatch__body">
										<h3 class="dispatch__title">{post.data.title}</h3>
										<p class="dispatch__deck">{post.data.description}</p>
									</div>
									{rt && <span class="dispatch__time">{rt} min</span>}
								</a>
							</li>
						);
					})}
				</ul>
			)
		}
	</section>
</Base>

<style>
	.series-desc {
		font-family: var(--font-body);
		font-style: italic;
		font-size: 1.15rem;
		color: var(--ink-soft);
		max-width: 56ch;
		margin: 1rem 0 2rem;
	}
	.series-empty {
		font-family: var(--font-body);
		font-size: 1.1rem;
		color: var(--ink-soft);
	}
</style>
