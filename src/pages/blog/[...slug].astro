---
import { render } from "astro:content";
import PostLayout from "../../layouts/Post.astro";
import { getPosts, type Post } from "../../lib/posts";
import Aside from "../../components/mdx/Aside.astro";
import Callout from "../../components/mdx/Callout.astro";
import Columns from "../../components/mdx/Columns.astro";
import Figure from "../../components/mdx/Figure.astro";
import PullQuote from "../../components/mdx/PullQuote.astro";
import TableWrap from "../../components/mdx/TableWrap.astro";
import InkRule from "../../components/InkRule.astro";
import LineChart from "../../components/charts/LineChart.astro";
import BarChart from "../../components/charts/BarChart.astro";
import IceMassChart from "../../components/charts/IceMassChart.astro";
import TemperatureChart from "../../components/charts/TemperatureChart.astro";
import Co2Chart from "../../components/charts/Co2Chart.astro";
import ScatterChart from "../../components/charts/ScatterChart.astro";
import InteractiveChart from "../../components/charts/InteractiveChart.tsx";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, allPosts: posts },
	}));
}

interface Props {
	post: Post;
	allPosts: Post[];
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const components = {
	Aside,
	Callout,
	Columns,
	Figure,
	PullQuote,
	TableWrap,
	Rule: InkRule,
	LineChart,
	BarChart,
	IceMassChart,
	TemperatureChart,
	Co2Chart,
	ScatterChart,
	InteractiveChart,
};
---

<PostLayout post={post} allPosts={allPosts}>
	<Content components={components} />
</PostLayout>
