---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionHead from "../../components/SectionHead.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getPosts, readingTime } from "../../lib/posts";

const posts = await getPosts();
const publishedSeriesIds = new Set(
	posts.map((p) => p.data.series?.id).filter((id): id is string => Boolean(id)),
);
const allSeries = (await getCollection("series")).filter((s) => publishedSeriesIds.has(s.id));

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	if (!byYear.has(year)) byYear.set(year, []);
	byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="Blog" description="Long-form posts on backend systems, LLM pipelines, and the craft of shipping." section="BLOG">
	<section class="section" style="padding-top: clamp(1.5rem, 3vw, 2.6rem)">
		<SectionHead num="§" title="Blog" />

		<div class="toc-grid">
			<div class="toc-main">
				{
					posts.length === 0 && (
						<p class="toc-empty">
							<em>No posts yet.</em>
						</p>
					)
				}
				{
					years.map((year) => (
						<div class="toc-year">
							<h2 class="toc-year__label">{year}</h2>
							<ul class="dispatch-list">
								{byYear.get(year)!.map((post) => {
									const rt = readingTime(post);
									return (
										<li class="dispatch">
											<a href={`/blog/${post.id}/`}>
												<span class="dispatch__date">
													<FormattedDate date={post.data.pubDate} />
												</span>
												<div class="dispatch__body">
													<h3 class="dispatch__title">{post.data.title}</h3>
												<p class="dispatch__deck">{post.data.description}</p>
											</div>
												{rt && <span class="dispatch__time">{rt} min</span>}
											</a>
										</li>
									);
								})}
							</ul>
						</div>
					))
				}
			</div>

			{
				allSeries.length > 0 && (
					<aside class="toc-side">
						<h2 class="toc-side__head">Series</h2>
						<ul class="toc-series">
							{allSeries.map((s) => (
								<li>
									<a href={`/blog/series/${s.id}/`}>{s.data.title}</a>
									<span class="toc-series__desc">{s.data.description}</span>
								</li>
							))}
						</ul>
					</aside>
				)
			}
		</div>
	</section>
</Base>

<style>
	.toc-grid {
		margin-top: clamp(1.5rem, 3vw, 2.5rem);
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}
	@media (min-width: 1000px) {
		.toc-grid {
			grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
		}
	}
	.toc-year__label {
		font-family: var(--font-display);
		font-style: normal;
		font-weight: 600;
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		color: var(--ink);
		margin: 2rem 0 0.4rem;
	}
	.toc-year:first-child .toc-year__label {
		margin-top: 0;
	}
	.toc-year .dispatch-list {
		margin-top: 0;
	}
	.toc-empty {
		font-family: var(--font-body);
		font-size: 1.2rem;
		color: var(--ink-soft);
	}
	.toc-side__head {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.01em;
		text-transform: none;
		color: var(--ink-soft);
		margin: 0 0 0.8rem;
	}
	.toc-series {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.toc-series a {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.3rem;
		letter-spacing: -0.01em;
		color: var(--ink);
		text-decoration: none;
	}
	.toc-series a:hover {
		color: var(--accent);
	}
	.toc-series__desc {
		display: block;
		font-family: var(--font-body);
		font-style: italic;
		font-size: 0.95rem;
		color: var(--ink-soft);
		margin-top: 0.15rem;
	}
</style>
