---
import Base from "../layouts/Base.astro";
import InkFrame from "../components/InkFrame.astro";
import InkLink from "../components/InkLink.astro";
import InkRule from "../components/InkRule.astro";
import Marginalia from "../components/Marginalia.astro";
import SectionHead from "../components/SectionHead.astro";
import Stamp from "../components/Stamp.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getPosts, readingTime, roman } from "../lib/posts";
import { EMAIL, GITHUB_URL, LINKEDIN_URL, SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const headlineDelay = (index: number) => `animation-delay: ${0.08 * index + 0.1}s`;

const posts = await getPosts();
const latest = posts.slice(0, 3);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero" data-screen-label="01 Hero" style="padding-top: 0">
		<div class="hero-grid" style="transform: translateY(0px)">
			<div class="hero-left">
				<div class="kicker">
					<span style="position: relative; display: inline-block; padding: 0.15em 0.45em">
						<svg
							style="position: absolute; inset: 0; width: 100%; height: 100%"
							viewBox="0 0 60 40"
							preserveAspectRatio="none"
							aria-hidden="true"
						>
							<path
								d="M 8 6 Q 30 2, 52 8 Q 56 20, 52 34 Q 30 38, 8 34 Q 4 20, 8 6 Z"
								fill="none"
								stroke="#b84a1f"
								stroke-width="1.5"
								vector-effect="non-scaling-stroke"
								stroke-linejoin="round"></path>
						</svg>
						<span style="position: relative"
							><span style="font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; letter-spacing: 0.08em"
								>№ 01</span
							></span
						>
					</span>
					<span class="kicker-text">FULLSTACK / AI ENGINEER - ITALY · CUBA · TH</span>
				</div>

				<div class="display-wrap">
					<h1 class="sr-only">Donzelli &amp; Diaz</h1>
					<div class="display display--main" aria-hidden="true" style="margin: 0">
						{"DONZELLI".split("").map((ch, i) => <span class="ink-letter" style={headlineDelay(i)}>{ch}</span>)}
					</div>
					<div class="display-row">
						<span class="amp" aria-hidden="true">&amp;</span>
						<div class="display display--alt" aria-hidden="true" style="margin: 0">
							{"DIAZ".split("").map((ch, i) => <span class="ink-letter" style={headlineDelay(i)}>{ch}</span>)}
						</div>
					</div>
				</div>

				<div class="subline">
					<span class="subline-l">AI Engineer</span>
					<span class="dot">·</span>
					<span>Backend</span>
					<span class="dot">·</span>
					<span>Six Years in Fintech &amp; GenAI</span>
				</div>

				<div class="hero-meta">
					<Marginalia rotate={-3}>
						↳ available for senior IC roles &amp; staff-level engagements
					</Marginalia>
				</div>
			</div>

			<aside class="hero-right">
				<div class="vert-label">EST.&nbsp;2019&nbsp;-&nbsp;CURRENTLY&nbsp;AT&nbsp;EPIPHANY&nbsp;(REMOTE)</div>
				<InkFrame class="hero-card">
					<div class="hero-card__inner">
						<div class="cap">FROM&nbsp;THE&nbsp;EDITOR</div>
						<p class="lede">
							A working dossier of <em>Lorenzo Donzelli</em>, six years between Italian banking floors and a
							Copenhagen-based AI company. Compiled here: the journal, the stack, the ledger.
						</p>
						<div class="folio">
							<span>Folio</span>
							<span class="folio-num">001</span>
						</div>
					</div>
				</InkFrame>
				<Stamp />
			</aside>
		</div>

		<div class="hero-foot">
			<InkRule />
			<div class="hero-foot-row">
				<span class="cap">Continue&nbsp;reading&nbsp;↓</span>
				<span class="cap">I. The Doors · II. Latest Dispatches · III. Correspondence</span>
			</div>
		</div>
	</section>

	<section class="section" data-screen-label="02 Doors">
		<SectionHead num="I." title="The Doors" sub="two ways in" />
		<div class="doors">
			<a class="door" href="/blog">
				<InkFrame>
					<span class="door__num">i.</span>
					<h2 class="door__title">The Journal</h2>
					<p class="door__deck">
						Long-form dispatches on backend systems, LLM pipelines, and the craft of shipping.
					</p>
					<span class="door__cta">Read the journal →</span>
				</InkFrame>
			</a>
			<a class="door" href="/about">
				<InkFrame>
					<span class="door__num">ii.</span>
					<h2 class="door__title">The Author</h2>
					<p class="door__deck">
						Identity, stack, and the ledger of roles — the curriculum vitae, in editorial form.
					</p>
					<span class="door__cta">About the author →</span>
				</InkFrame>
			</a>
		</div>
	</section>

	{
		latest.length > 0 && (
			<section class="section" data-screen-label="03 Dispatches">
				<SectionHead num="II." title="Latest Dispatches" sub="fresh off the press" />
				<ol class="dispatch-list">
					{latest.map((post, i) => {
						const rt = readingTime(post);
						return (
							<li class="dispatch">
								<a href={`/blog/${post.id}/`}>
									<span class="dispatch__num">{roman(i + 1)}.</span>
									<span class="dispatch__date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<div class="dispatch__body">
										<h3 class="dispatch__title">{post.data.title}</h3>
										<p class="dispatch__deck">{post.data.description}</p>
									</div>
									{rt && <span class="dispatch__time">{rt} min</span>}
								</a>
							</li>
						);
					})}
				</ol>
			</section>
		)
	}

	<section class="section" data-screen-label="04 Contact">
		<SectionHead num="III." title="Correspondence" sub="the door is open" />
		<div class="contact-grid">
			<div class="contact-pitch">
				<p class="contact-line">
					If you are building something that needs a backend that won&rsquo;t quietly fall over, or an LLM
					pipeline that won&rsquo;t hallucinate your business away,
				</p>
				<p class="contact-line contact-line--big">
					<em>write.</em>
				</p>
			</div>

			<InkFrame class="contact-card">
				<div class="contact-card__inner">
					<div class="contact-row">
						<span class="cap">e-mail</span>
						<InkLink href={`mailto:${EMAIL}`}>{EMAIL}</InkLink>
					</div>
					<div class="contact-row">
						<span class="cap">linkedin</span>
						<InkLink href={LINKEDIN_URL} external>/in/lorenzo-donzelli-diaz-71796b94</InkLink>
					</div>
					<div class="contact-row">
						<span class="cap">github</span>
						<InkLink href={GITHUB_URL} external>{GITHUB_URL.replace("https://", "")}</InkLink>
					</div>
				</div>
			</InkFrame>

			<div class="contact-aside">
				<svg
					style="width: 110px; height: 70px; transform: translateY(-1rem)"
					viewBox="0 0 140 90"
					aria-hidden="true"
				>
					<g transform="scale(-1,1) translate(-140,0)">
						<path
							d="M 10 10 Q 40 30, 60 50 T 110 78"
							fill="none"
							stroke="#0e0c0a"
							stroke-width="1.3"
							stroke-linecap="round"
							vector-effect="non-scaling-stroke"></path>
						<path
							d="M 100 70 Q 108 76, 112 80 Q 106 78, 98 82"
							fill="none"
							stroke="#0e0c0a"
							stroke-width="1.3"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</g>
				</svg>
				<Marginalia rotate={-5} style="display: block; margin-top: 0.4rem">
					replies, usually within a day
				</Marginalia>
			</div>
		</div>
	</section>

	<script is:inline>
		const heroGrid = document.querySelector(".hero-grid");
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

		// Opt into the ink entrance only when JS runs and motion is welcome.
		if (!reduceMotion.matches) {
			document.querySelector(".display-wrap")?.classList.add("ink-anim");
		}

		const updateHeroOffset = () => {
			if (heroGrid && !reduceMotion.matches) {
				heroGrid.style.transform = `translateY(${window.scrollY * -0.08}px)`;
			}
		};

		window.addEventListener("scroll", updateHeroOffset, { passive: true });
	</script>
</Base>
