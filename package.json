{
  "name": "donzelli-diaz",
  "description": "Personal site and journal of Lorenzo Donzelli Diaz.",
  "type": "module",
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/preact": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@observablehq/plot": "^0.6.17",
    "astro": "^7.3.3",
    "katex": "^0.18.7",
    "preact": "^10.28.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-reading-time": "^2.1.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "html-validate": "^11.16.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "build:drafts": "INCLUDE_DRAFTS=1 astro build",
    "check": "astro check && tsc --noEmit",
    "dev": "astro dev",
    "preview": "astro build && astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:links": "node scripts/check-links.mjs",
    "test:deploy": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  }
}
